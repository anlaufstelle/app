{
    # Proxy-Vertrauen (Refs #1963). Caddy uebernimmt ein eingehendes
    # X-Forwarded-For NUR von einem Peer aus dieser Liste; von jedem anderen
    # Peer ERSETZT es den Header durch dessen IP. Leer = kein vorgelagerter
    # Proxy (Regelfall: Caddy ist der Edge) — dann kommt bei der App genau
    # EIN Eintrag an und TRUSTED_PROXY_HOPS=1 trifft ihn.
    # Steht ein CDN/Loadbalancer davor, MUESSEN dessen Bereiche hier stehen,
    # BEVOR TRUSTED_PROXY_HOPS auf 2 gesetzt wird: sonst sieht die App nie
    # zwei Eintraege und faellt auf REMOTE_ADDR (die Proxy-IP) zurueck —
    # ein gemeinsamer Ratelimit-Eimer, eine Lockout-Achse und eine Audit-IP
    # fuer alle. Dieselbe Variable liest settings.TRUSTED_PROXY_CIDRS; ein
    # unbrauchbarer Wert bricht dort bereits den Start ab (core.E003).
    # trusted_proxies_strict laesst Caddy die Client-IP-Header von RECHTS
    # lesen (ab Caddy 2.8) und damit den vom Proxy gesetzten statt des vom
    # Client kontrollierten Eintrags nehmen.
    servers {
        trusted_proxies static {$TRUSTED_PROXY_CIDRS}
        trusted_proxies_strict
    }

    # Fehler-Protokoll (Refs #1963). Der 'format filter'-Encoder oben haengt am
    # Site-Logger und deckt nur http.log.access.* ab. Caddys FEHLER-Logger
    # http.log.error.* laeuft davon unberuehrt auf stderr — im Container also in
    # den Docker-json-file-Log des Hosts: ausserhalb dieses Volumes, ausserhalb
    # roll_keep_for und ausserhalb jeder Loeschlogik. Er traegt dieselbe
    # request>uri samt Query wie der Access-Log und entsteht bei JEDEM
    # Handler-Fehler: Upstream weg (502/504 im Deploy-Fenster, Worker-OOM,
    # gunicorn-Restart) oder 413 aus request_body max_size.
    # Dieser benannte Logger holt ihn in dasselbe Volume, unter dieselbe
    # Aufbewahrung und durch dieselbe Redaktion. Doppelt steht dadurch nichts
    # im Log: Der Caddyfile-Adapter traegt http.log.error selbst in
    # logging.logs.default.exclude ein, stderr bleibt fuer alles uebrige
    # zustaendig (Caddy-eigene Fehler wie tls.* also weiterhin in 'docker logs').
    log errors {
        include http.log.error
        output file /var/log/caddy/error.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format filter {
            request>uri regexp "[?].*" "?redigiert"
            request>headers>Referer regexp "[?].*" "?redigiert"
            resp_headers>Location regexp "[?].*" "?redigiert"
            wrap json
        }
    }
}

# www-Variante auf Apex umleiten (Refs #801).
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
    reverse_proxy web:8000

    # Defense-in-Depth gegen Disk-Fill/OOM (Refs #1363, N10 + Review-Nachschlag):
    # weist Request-Bodies oberhalb der App-seitigen Obergrenze schon am Edge
    # ab, bevor sie den Gunicorn-Worker erreichen. Dimensioniert fuer EIN
    # volles Multi-File-Feld: ``FILE_VAULT_MAX_UPLOAD_BYTES`` (Default 50 MiB)
    # * ``FILE_VAULT_MAX_UPLOAD_FILES`` (Default 20 Dateien/Feld,
    # MultipleFileInput/Refs #622) = 1000 MiB, + 10 % Marge fuer
    # Multipart-Overhead (Boundaries, Feld-Header, CSRF-Token u.ae.) = 1100 MiB.
    # Ein kleinerer, nur auf EINE Datei dimensionierter Cap weist legitime
    # Multi-File-Uploads (bereits unterstuetztes Feature) am Edge mit 413 ab,
    # obwohl jede einzelne Datei alle App-seitigen Checks bestehen wuerde.
    # WICHTIG: rein statisch, folgt NICHT automatisch einer per Env
    # ueberschriebenen ``FILE_VAULT_MAX_UPLOAD_BYTES``/``FILE_VAULT_MAX_UPLOAD_FILES``
    # — bei Aenderung eines der beiden App-Limits diesen Wert manuell
    # nachziehen und Caddy neu laden (docs/ops-runbook.md § 5.7).
    # Restrisiko (dokumentiert, nicht gefixt): ein DocumentType KANN mehrere
    # FILE-Felder tragen (nur von facility_admin/super_admin konfigurierbar)
    # — dann steigt der theoretische Worst-Case je zusaetzlichem Feld um
    # weitere 1000 MiB. Test-Guard: test_architecture_guards_ops.py::TestCaddyUploadBodyLimit.
    request_body {
        max_size 1100MiB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # X-Robots-Tag (A7.4, Refs #1024): Anlaufstelle ist eine geschlossene
        # Fachsoftware mit sensiblen Daten — keine Suchmaschinen-Indizierung
        # erwünscht (gilt auch für Staging/Dev-Deployments). Default noindex/
        # nofollow; per X_ROBOTS_TAG-Env überschreibbar, falls je gewünscht.
        X-Robots-Tag "{$X_ROBOTS_TAG:noindex, nofollow}"
        # CSP wird ausschließlich über Django-CSP-Middleware gesteuert (settings/base.py)
    }

    # Access-Log nach /var/log/caddy/access.log (Container-Pfad). Der
    # Operator mountet das Verzeichnis als Volume in docker-compose.prod.yml,
    # damit Logs den Container-Restart ueberleben. Refs #801.
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 10
            # Ohne diesen Wert haelt Caddy rotierte Logs nach eigenem Default
            # (90 Tage) vor — mit vollstaendigen Client-IPs. Refs #1963.
            roll_keep_for 720h
        }
        # Query-Redaktion (Refs #1963): request>uri trug den kompletten
        # Query-String ins Log — Volltext-Suchbegriffe (q) und Objekt-IDs
        # (client/case/event/user/assigned_to), also Klarnamen und
        # Pseudonym-Referenzen ausserhalb von Audit- und Loeschlogik.
        # Bewusst der ganze Query-Teil statt einer Denylist einzelner
        # Parameter: die driftet mit jedem neuen Filter. Der Pfad bleibt
        # stehen, damit 4xx/5xx weiter einer Route zuzuordnen sind.
        # Referer (bei gleichem Origin schickt der Browser die volle URL)
        # und Location (Redirects mit ?next=) tragen dieselbe Query erneut.
        format filter {
            request>uri regexp "[?].*" "?redigiert"
            request>headers>Referer regexp "[?].*" "?redigiert"
            resp_headers>Location regexp "[?].*" "?redigiert"
            wrap json
        }
    }

    # Optionaler Rate-Limit (Defense-in-Depth gegen Login-/API-Brute-Force).
    # Standardmaessig nicht aktiv, da Caddy ohne Plugin keine Rate-Limits
    # unterstuetzt. Operatoren, die einen Limit benoetigen, koennen
    # caddy-ratelimit (https://github.com/mholt/caddy-ratelimit) als Modul
    # in ein eigenes Caddy-Image bauen und z. B. folgendes ergaenzen:
    #
    #     rate_limit {
    #         zone login_zone {
    #             key {http.request.remote_host}
    #             events 10
    #             window 1m
    #         }
    #         match {
    #             path /login/* /accounts/* /api/*
    #         }
    #     }
    #
    # Siehe docs/coolify-deployment.md.
}
