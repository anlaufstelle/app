msgid "Eine Person kann nicht mit sich selbst zusammengeführt werden."
msgstr "A person cannot be merged with itself."

#: src/core/services/client/merge.py:315
msgid "Beide Personen müssen zur selben Einrichtung gehören."
msgstr "Both persons must belong to the same facility."

#: src/core/services/client/merge.py:318
msgid "Personen im Papierkorb können nicht zusammengeführt werden."
msgstr "Persons in the trash cannot be merged."

#: src/core/services/client/merge.py:320
msgid "Anonymisierte Personen können nicht zusammengeführt werden."
msgstr "Anonymized persons cannot be merged."

